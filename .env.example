# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Server-side process.env is preferred; browser localStorage persistence is disabled)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# OPTIONAL LOGTO OIDC CONFIGURATION (Dual-mode Auth support)
AUTH_MODE="SUPABASE_AUTH"
LOGTO_ENDPOINT="https://your-tenant.logto.app"
LOGTO_APP_ID="your-logto-app-id"
VITE_LOGTO_ENDPOINT="https://your-tenant.logto.app"
VITE_LOGTO_APP_ID="your-logto-app-id"

# OPTIONAL DEFAULT LINGXING MCP CONFIGURATION (Per-tenant keys stored in Supabase)
LINGXING_MCP_URL="https://mcp.lingxing.com/mcp"
LINGXING_MCP_KEY="lx_mcp_your_key"

